import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import pandas as pd

# O Violin plot é uma combinação de boxplot e KDE (Kernel Density Estimation), que mostra a distribuição dos dados e suas estatísticas resumidas.
# E utul para visualizar a distribuição de uma variável contínua em diferentes categorias.

# 1 - Criando dados ficticios de um DataFrame
categorias = ['Eletronicos', 'Roupas', 'Alimentos', 'Livros']
vendas = {
    'categorias': np.random.choice(categorias, 1000),
    'vendas': np.random.normal(loc=50, scale=20, size=1000)

}

df = pd.DataFrame(vendas)
print(df)

# 2 - Criando o violin plot usando seaborn
plt.figure(figsize=(8,6))
sns.violinplot(x='categorias', y='vendas', data=df, palette='muted')
plt.title('Distribuicao das Vendas por Categoria')
plt.xlabel('categorias')
plt.ylabel('vendas')
plt.show()